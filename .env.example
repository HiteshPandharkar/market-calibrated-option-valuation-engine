# Obtain a short-lived access token through the Upstox authentication flow.
UPSTOX_ACCESS_TOKEN=

# Required only by the opt-in live API tests. Use a liquid equity instrument.
# Example format: NSE_EQ|<ISIN>
UPSTOX_TEST_INSTRUMENT_KEY=
# Use a liquid option contract so both top-of-book sides are normally present.
# Example format: NSE_FO|<instrument token>
UPSTOX_TEST_OPTION_INSTRUMENT_KEY=
# Explicit non-Upstox inputs for the opt-in end-to-end valuation test.
UPSTOX_TEST_RISK_FREE_RATE=
UPSTOX_TEST_DIVIDEND_YIELD=
# Set to 1 only when intentionally running tests against Upstox.
UPSTOX_RUN_LIVE_TESTS=0

# Optional overrides:
# UPSTOX_TIMEOUT_SECONDS=10
# UPSTOX_API_BASE_URL=https://api.upstox.com
# UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
